# Ollama Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.5:0.8b
EMBEDDING_MODEL=mxbai-embed-large

# LLM behavior (qwen3.5 is a reasoning model; keep thinking off on CPU hardware)
LLM_REASONING=false
LLM_NUM_PREDICT=512
LLM_NUM_CTX=4096

# ChromaDB Configuration
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION_NAME=mtg_rules

# PDF Parser Configuration
PDF_PARSER_DIR=/app/data/pdf_parser
RULES_PDF_FILENAME=MagicCompRules.pdf
RULES_JSON_FILENAME=MagicCompRule_parsed_hierarchical.json

# Scryfall API
SCRYFALL_API_BASE=https://api.scryfall.com

# FastAPI Server
HOST=0.0.0.0
PORT=8000

# System
LOG_LEVEL=INFO
