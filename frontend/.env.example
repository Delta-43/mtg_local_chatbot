# Base URL of the mtg_local_chatbot backend API (no trailing slash).
# The PWA calls this cross-origin with no X-API-Key -- see src/api/client.ts
# for why a client-side key wouldn't actually be secret. The backend's CORS
# allowlist (CORS_ALLOWED_ORIGINS) must include this app's origin.
#
# This file is for local `npm run dev` only. The production image
# (frontend/Dockerfile, built by the `caddy` compose service) is a same-origin
# deploy and sets VITE_API_BASE_URL="" at build time instead -- see the root
# .env.example.
VITE_API_BASE_URL=http://localhost:8000
