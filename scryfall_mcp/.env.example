# Leave blank to use the built-in default defined in src/version.ts.
SCRYFALL_USER_AGENT=
RATE_LIMIT_MS=100
# Maximum number of queued Scryfall operations. Requests are paced globally.
# The client enforces at least 500 ms for Scryfall's 2/sec card endpoints
# (/cards/search, /cards/named, /cards/random, /cards/collection) even if RATE_LIMIT_MS is lower.
RATE_LIMIT_QUEUE_MAX=500
LOG_LEVEL=info
NODE_ENV=development
SCRYFALL_TIMEOUT_MS=15000
HEALTHCHECK_DEEP=false
CACHE_MAX_SIZE=10000
# Large bulk resources are only retained when their serialized payload fits this cap.
CACHE_MAX_MEMORY_MB=100
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
HTTP_MCP_PATH=/mcp
HTTP_HEALTH_PATH=/health
# Maximum HTTP POST body size in bytes (1 KiB to 10 MiB).
HTTP_MAX_BODY_BYTES=1048576
HTTP_SESSION_IDLE_MS=1800000
HTTP_SESSION_CLEANUP_INTERVAL_MS=60000
# Optional comma-separated allowlist for browser-style Origin headers.
# Leave unset to allow only loopback origins by default.
HTTP_ALLOWED_ORIGINS=
